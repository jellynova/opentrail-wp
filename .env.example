# ============================================================
# OpenTrail WP — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# --- Database ---
POSTGRES_DB=opentrail
POSTGRES_USER=opentrail
POSTGRES_PASSWORD=change_me_strong_password_here

# --- Application Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_with_secrets_token_hex_32

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used to encrypt ERP connector passwords at rest.
FERNET_KEY=change_me_generate_with_fernet_generate_key

# --- Network ---
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost,http://localhost:80

# Port the application listens on (default 80)
APP_PORT=80

# --- Frontend ---
VITE_API_BASE_URL=/api

# --- Documents Storage ---
# Path inside the backend container where uploaded working papers are stored.
# Mounted as a Docker volume — do not change unless you know what you're doing.
DOCUMENTS_PATH=/app/documents
